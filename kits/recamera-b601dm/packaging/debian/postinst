#!/bin/sh
set -e

mkdir -p /userdata/local/apps
cp -f /usr/share/rebot-teleop/rebot-teleop.json /userdata/local/apps/rebot-teleop.json
cp -f /usr/share/rebot-teleop/rebot-teleop.zh.md /userdata/local/apps/rebot-teleop.zh.md 2>/dev/null || true
cp -f /usr/share/rebot-teleop/rebot-teleop.md /userdata/local/apps/rebot-teleop.md 2>/dev/null || true

mkdir -p /userdata/datasets

# rebot-vision: config and user models live on /userdata (models are not in the package)
mkdir -p /userdata/rebot-teleop/models
if [ ! -f /userdata/rebot-teleop/vision.json ]; then
    cp -f /usr/share/rebot-teleop/vision.json.default /userdata/rebot-teleop/vision.json 2>/dev/null || true
fi

# An upgrade runs the old package's prerm (init stop) before the files are replaced. A vision
# loop of the old package still running now (still waiting for rebot-vision, or hung without
# a child as 1.2.1 could after an upgrade) is stopped by the new init script, which waits for
# rebot-vision and sends SIGKILL only to a loop that has no child left.
if [ -x /etc/init.d/K92rebot-teleop ]; then
    /etc/init.d/K92rebot-teleop stop-vision || true
fi

# Boot start. With the reCamera console, app_restore starts the active app (state.json) at
# boot; an S?? link as well would start a second camera holder when another camera app is
# active. So: with the console, remove every S??rebot-teleop link (older installs left S92 or
# S94) and record rebot-teleop as the console's active app, as a console switch would (the
# camera app that was active keeps running until the next boot or a start of rebot-teleop,
# which stops it; nothing is disabled or uninstalled). Without the console, an S92 link.
if [ -x /usr/share/supervisor/scripts/main.sh ]; then
    for link in /etc/init.d/S??rebot-teleop; do
        if [ -L "$link" ]; then
            rm -f "$link"
        fi
    done
    /etc/init.d/K92rebot-teleop register || true
else
    ln -sf /etc/init.d/K92rebot-teleop /etc/init.d/S92rebot-teleop 2>/dev/null || true
fi

# 修正安装文件所有权为 root
chown -R root:root /etc/init.d/K92rebot-teleop /usr/bin/armd /usr/local/bin/armd /usr/bin/rebot-vision /userdata/local/apps/ 2>/dev/null || true

# 刷新 overlayfs 缓存，确保 supervisor 立即感知到 /etc/init.d/K92rebot-teleop
sync
echo 2 > /proc/sys/vm/drop_caches 2>/dev/null || true

exit 0
