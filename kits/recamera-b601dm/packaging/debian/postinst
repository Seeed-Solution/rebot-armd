#!/bin/sh
set -e

mkdir -p /userdata/local/apps
cp -f /usr/share/rebot-teleop/rebot-teleop.json /userdata/local/apps/rebot-teleop.json
cp -f /usr/share/rebot-teleop/rebot-teleop.zh.md /userdata/local/apps/rebot-teleop.zh.md 2>/dev/null || true
cp -f /usr/share/rebot-teleop/rebot-teleop.md /userdata/local/apps/rebot-teleop.md 2>/dev/null || true

mkdir -p /userdata/datasets

# rebot-vision: config and user models live on /userdata (models are not in the package)
mkdir -p /userdata/rebot-teleop/models
if [ ! -f /userdata/rebot-teleop/vision.json ]; then
    cp -f /usr/share/rebot-teleop/vision.json.default /userdata/rebot-teleop/vision.json 2>/dev/null || true
fi

# Boot start. With the reCamera console, app_restore starts the active app at boot; an S92 link
# as well would start a second camera holder when another camera app is active. So S92 only
# without the console, and an S92 link of ours is removed when the console is present.
if [ -x /usr/share/supervisor/scripts/main.sh ]; then
    if [ -L /etc/init.d/S92rebot-teleop ] && [ "$(readlink /etc/init.d/S92rebot-teleop)" = /etc/init.d/K92rebot-teleop ]; then
        rm -f /etc/init.d/S92rebot-teleop
    fi
else
    ln -sf /etc/init.d/K92rebot-teleop /etc/init.d/S92rebot-teleop 2>/dev/null || true
fi

# 修正安装文件所有权为 root
chown -R root:root /etc/init.d/K92rebot-teleop /usr/bin/armd /usr/local/bin/armd /usr/bin/rebot-vision /userdata/local/apps/ 2>/dev/null || true

# 刷新 overlayfs 缓存，确保 supervisor 立即感知到 /etc/init.d/K92rebot-teleop
sync
echo 2 > /proc/sys/vm/drop_caches 2>/dev/null || true

exit 0
