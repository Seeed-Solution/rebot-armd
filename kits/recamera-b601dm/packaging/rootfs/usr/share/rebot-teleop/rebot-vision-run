#!/bin/sh
# rebot-vision-run: keeps rebot-vision (the kit's camera process) running. Started by
# /etc/init.d/K92rebot-teleop with its pid in /var/run/rebot-vision.pid.
# - rebot-vision runs in its own session (setsid) at nice 10 so armd's control loop wins
#   CPU contention and a process-group signal from vision cannot reach this runner.
# - After any exit not requested by SIGTERM/SIGINT to this runner, it restarts with backoff
#   1, 2, 4 ... 30 s (back to 1 s after a run longer than 60 s) and gives up after 10 starts
#   within 5 minutes.
# - SIGTERM: forwards SIGTERM (never SIGKILL: a killed camera holder leaves VPSS groups
#   allocated) to rebot-vision, waits for it and exits.
# - Never blocks inside `wait`: BusyBox 1.33.0 ash (reCamera 0.2.6 /bin/sh) spins at 100%
#   CPU forever inside blocking `wait` when a background child exits and stops running traps
#   until SIGKILL. Polling /proc/<pid>/status (pure shell) + foreground sleep avoids blocking
#   `wait` completely; `wait "$child"` is called only after all threads have exited.
# - Tuning, for tests: REBOT_VISION_BACKOFF_MAX, REBOT_VISION_STABLE_SECS,
#   REBOT_VISION_GIVEUP_STARTS, REBOT_VISION_GIVEUP_WINDOW.
# - Everything is in functions and the last line calls main: the shell has parsed the whole
#   file before the loop starts, so a package upgrade that replaces this file while the loop
#   runs cannot make the running shell read the new text.

BIN=${REBOT_VISION_BIN:-/usr/bin/rebot-vision}
CONF=${REBOT_VISION_CONF:-/userdata/rebot-teleop/vision.json}
LOG=${REBOT_VISION_LOG:-/var/log/rebot-vision.log}
INIT_SCRIPT=${REBOT_TELEOP_INIT:-/etc/init.d/K92rebot-teleop}
BACKOFF_MAX=${REBOT_VISION_BACKOFF_MAX:-30}
STABLE_SECS=${REBOT_VISION_STABLE_SECS:-60}
GIVEUP_STARTS=${REBOT_VISION_GIVEUP_STARTS:-10}
GIVEUP_WINDOW=${REBOT_VISION_GIVEUP_WINDOW:-300}

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [rebot-vision-run] $*" >> "$LOG"; }

on_term() {
    stopping=1
    [ -n "$child" ] && kill -TERM "$child" 2>/dev/null
}

# True while process $1 (or any sibling thread in its thread group) has not exited.
# Pure shell (no fork) so waiting adds no extra forks beyond the sleep interval.
proc_alive() {
    [ -r "/proc/$1/status" ] || return 1
    while IFS= read -r line; do
        case "$line" in
            State:*Z*|State:*X*)
                # Multi-threaded process: wait until sibling threads finish exiting too.
                for t in "/proc/$1/task/"*; do
                    [ "$t" = "/proc/$1/task/$1" ] && continue
                    [ -d "$t" ] && return 0
                done
                return 1
                ;;
            State:*) return 0 ;;
        esac
    done < "/proc/$1/status" 2>/dev/null
    return 1
}

# Wait until rebot-vision ($child) has exited; its status in rc.
# On Linux (/proc/self present), poll until all threads of $child have exited so `wait`
# never blocks (avoiding BusyBox 1.33.0 ash's blocking-wait 100% CPU hang) and still reaps
# the zombie and returns its exit code.
wait_child() {
    rc=0
    if [ -d /proc/self ]; then
        while proc_alive "$child"; do
            if [ "$stopping" -eq 1 ]; then
                sleep 0.2
            else
                sleep 0.5
            fi
        done
        wait "$child" 2>/dev/null
        rc=$?
        return 0
    fi
    while :; do
        wait "$child"
        rc=$?
        [ "$rc" -eq 127 ] && break
        kill -0 "$child" 2>/dev/null || break
        sleep 0.2
    done
}

# Sleep $1 seconds in short foreground steps so SIGTERM/SIGINT ends backoff promptly
# without `sleep & wait $!` (which hits the same BusyBox 1.33.0 ash blocking-wait bug).
sleep_interruptible() {
    ticks=$(($1 * 2))
    while [ "$ticks" -gt 0 ] && [ "$stopping" -eq 0 ]; do
        sleep 0.5
        ticks=$((ticks - 1))
    done
}

main() {
    export LD_LIBRARY_PATH=/mnt/system/lib:/mnt/system/usr/lib:/mnt/system/usr/lib/3rd:/mnt/system/lib/3rd:/lib:/usr/lib
    SETSID=""
    command -v setsid >/dev/null 2>&1 && SETSID="setsid"
    NICE="nice -n 10"
    command -v nice >/dev/null 2>&1 || NICE=""

    child=""
    stopping=0
    trap on_term TERM INT

    starts=""
    delay=1
    while [ "$stopping" -eq 0 ]; do
        now=$(date +%s)
        recent=""
        n=0
        for s in $starts; do
            if [ $((now - s)) -lt "$GIVEUP_WINDOW" ]; then recent="$recent $s"; n=$((n + 1)); fi
        done
        starts="$recent"
        if [ "$n" -ge "$GIVEUP_STARTS" ]; then
            log "$GIVEUP_STARTS starts within ${GIVEUP_WINDOW}s; giving up (see the messages above)"
            return 1
        fi
        starts="$starts $now"
        $SETSID $NICE "$BIN" --config "$CONF" >> "$LOG" 2>&1 &
        child=$!
        # a SIGTERM between the fork and the line above found no child to forward to
        if [ "$stopping" -eq 1 ]; then
            kill -TERM "$child" 2>/dev/null
        elif [ -x "$INIT_SCRIPT" ]; then
            "$INIT_SCRIPT" rt-priorities --settle >/dev/null 2>&1 || true
        fi
        wait_child
        child=""
        [ "$stopping" -eq 1 ] && break
        if [ $(( $(date +%s) - now )) -gt "$STABLE_SECS" ]; then delay=1; fi
        log "rebot-vision exited ($rc); restarting in ${delay}s"
        sleep_interruptible "$delay"
        [ "$stopping" -eq 1 ] && break
        delay=$((delay * 2))
        [ "$delay" -gt "$BACKOFF_MAX" ] && delay=$BACKOFF_MAX
    done
    return 0
}

main "$@"; exit $?
