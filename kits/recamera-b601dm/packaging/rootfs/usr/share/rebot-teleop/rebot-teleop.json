{
  "id": "rebot-teleop",
  "name": "reBot Teleoperation & Vision",
  "name_zh": "reBot 具身视觉遥控与机械臂驱动",
  "scene": "Robotics & Embodied AI",
  "scene_zh": "机器人与具身智能",
  "description": "reBot B601-DM arm control on the reCamera: arm on the B4 board CAN bus, Wi-Fi AP hotspot, browser cockpit with touch teleoperation, hand-eye calibration, tap-to-grasp, gravity-compensation hand-guiding and recording to Parquet files. Vision is included (H.264 video, YOLO object detection on the TPU, ArUco markers); no other camera app is needed.",
  "description_zh": "reCamera 上的 reBot B601-DM 机械臂控制：机械臂接 B4 底板 CAN 总线，开机自启 Wi-Fi 热点，浏览器驾驶舱支持触屏遥控、手眼标定、点选抓取、重力补偿拖动示教与 Parquet 录制。已内置视觉（H.264 视频、TPU 运行 YOLO 物体识别、ArUco 标记识别），无需再安装其他相机应用。",
  "type": "native",
  "init_script": "/etc/init.d/K92rebot-teleop",
  "stream_mode": "ws",
  "debug_ws": {
    "port": 8001,
    "video_path": "/",
    "results_path": "/results"
  },
  "web_port": 8765,
  "models": [],
  "requires": ["can"],
  "config_schema": {
    "groups": [
      {
        "key": "arm",
        "title": "Robotic Arm Hardware",
        "title_zh": "机械臂硬件配置",
        "items": [
          {
            "key": "follower_model",
            "type": "select",
            "title": "Arm Model",
            "title_zh": "机械臂型号",
            "options": ["rebot-dm", "mock"],
            "default": "rebot-dm"
          },
          {
            "key": "serial_port",
            "type": "serial_port",
            "title": "Port / CAN Interface",
            "title_zh": "从手通信端口/CAN接口",
            "default": "can0"
          },
          {
            "key": "baud_rate",
            "type": "number",
            "title": "Baud Rate",
            "title_zh": "波特率",
            "default": 1000000
          }
        ]
      },
      {
        "key": "network",
        "title": "Wi-Fi Hotspot & Client",
        "title_zh": "Wi-Fi 热点与联网配置",
        "items": [
          {
            "key": "ap_ssid",
            "type": "text",
            "title": "AP Hotspot SSID",
            "title_zh": "热点名称 (SSID)",
            "default": "reCamera-Arm-Teleop"
          },
          {
            "key": "ap_password",
            "type": "password",
            "title": "AP Password",
            "title_zh": "热点密码 (至少8位)",
            "default": "12345678"
          },
          {
            "key": "ap_ip",
            "type": "text",
            "title": "AP Gateway IP",
            "title_zh": "热点网关 IP",
            "default": "192.168.16.1"
          },
          {
            "key": "ap_band",
            "type": "select",
            "title": "AP Band (5g = 5 GHz, 2g4 = 2.4 GHz; 5 GHz falls back to 2.4 GHz channel 6 if it fails to start)",
            "title_zh": "热点频段（5g = 5 GHz，2g4 = 2.4 GHz；5 GHz 启动失败时自动改用 2.4 GHz 信道 6）",
            "options": ["5g", "2g4"],
            "default": "5g"
          },
          {
            "key": "ap_channel",
            "type": "number",
            "title": "AP Channel (0 = default: 44 on 5 GHz, 6 on 2.4 GHz)",
            "title_zh": "热点信道（0 = 默认：5 GHz 用 44，2.4 GHz 用 6）",
            "default": 0
          },
          {
            "key": "sta_ssid",
            "type": "text",
            "title": "External Wi-Fi SSID",
            "title_zh": "外部 Wi-Fi 名称 (可选)",
            "default": ""
          },
          {
            "key": "sta_password",
            "type": "password",
            "title": "External Wi-Fi Password",
            "title_zh": "外部 Wi-Fi 密码",
            "default": ""
          }
        ]
      }
    ]
  }
}
