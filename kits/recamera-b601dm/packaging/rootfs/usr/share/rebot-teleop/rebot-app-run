#!/bin/sh
# rebot-app-run <app-name>: runs a user program on rebot-teleop and keeps it running.
# Started by /etc/init.d/K92rebot-teleop (app-start) with its pid in /var/run/rebot-app.pid.
# App directory: $REBOT_APPS_DIR/<name> (default /userdata/rebot-apps/<name>) with main.py, or
# app.json {"entry": "main.py", "restart": "on-failure" | "always" | "never"} (default
# on-failure). The program runs as `nice -n 5 python3 -u <entry>` in the app directory with
# REBOT_HOST=127.0.0.1 and PYTHONPATH=/usr/share/rebot-teleop/python:<app dir>.
# - User: the program runs as $REBOT_APP_USER (default recamera, unprivileged; HOME, USER and
#   LOGNAME set to it), never as root. A missing user, a root user, or a runner that is not
#   root and asked for another user refuses the start (logged, state stopped, exit 1).
# - Process group: the program starts in its own session; stop and restart signal the whole
#   group, so processes it started do not survive it.
# - Restart: exit code 0 ends the runner with on-failure; any other exit restarts with backoff
#   1, 2, 4 ... 30 s (back to 1 s after a run longer than 60 s); 10 starts within 5 minutes
#   end the runner with state given_up. "always" restarts after exit code 0 too, "never" never.
# - SIGTERM: forwarded to the program's process group; SIGKILL to the group when the program
#   is still running after 10 s. When the program has exited, what is left of its group is
#   sent SIGKILL.
# - Log: stdout and stderr of the program and the runner's own lines are appended to
#   $REBOT_APP_LOG_DIR/app-<name>.log (default /userdata/rebot-teleop/logs). The size is
#   checked before every start and every 30 s while the program runs; above 512 KiB the log is
#   copied to app-<name>.log.1 (older: .2, the previous .2 is deleted) and truncated in place.
#   Bytes written between the copy and the truncate are lost.
# - State file $REBOT_APP_STATE_DIR/rebot-app-<name>.state (default /tmp): state (running |
#   backoff | stopped | given_up), pid (program), runner (this process), starts, last_exit.
# - Tuning, for tests: REBOT_APP_USER, REBOT_APP_BACKOFF_MAX, REBOT_APP_STABLE_SECS, REBOT_APP_GIVEUP_STARTS,
#   REBOT_APP_GIVEUP_WINDOW, REBOT_APP_KILL_GRACE, REBOT_APP_LOG_MAX, REBOT_APP_LOG_CHECK,
#   REBOT_APP_PYTHONPATH, REBOT_APP_PYTHON.
# - Everything is in functions and the last line calls main (see rebot-vision-run).

APPS_DIR=${REBOT_APPS_DIR:-/userdata/rebot-apps}
LOG_DIR=${REBOT_APP_LOG_DIR:-/userdata/rebot-teleop/logs}
STATE_DIR=${REBOT_APP_STATE_DIR:-/tmp}
BACKOFF_MAX=${REBOT_APP_BACKOFF_MAX:-30}
STABLE_SECS=${REBOT_APP_STABLE_SECS:-60}
GIVEUP_STARTS=${REBOT_APP_GIVEUP_STARTS:-10}
GIVEUP_WINDOW=${REBOT_APP_GIVEUP_WINDOW:-300}
KILL_GRACE=${REBOT_APP_KILL_GRACE:-10}
LOG_MAX=${REBOT_APP_LOG_MAX:-524288}
LOG_CHECK=${REBOT_APP_LOG_CHECK:-30}
SDK_PATH=${REBOT_APP_PYTHONPATH:-/usr/share/rebot-teleop/python}
PYTHON=${REBOT_APP_PYTHON:-python3}
RUN_USER=${REBOT_APP_USER:-recamera}

# python3 -c "$LAUNCH" <user> <command...>: new session (own process group), drop to <user>
# (supplementary groups from /etc/group), then exec the command.
LAUNCH='import os, pwd, sys
u = pwd.getpwnam(sys.argv[1])
os.setsid()
if os.getuid() != u.pw_uid:
    os.initgroups(u.pw_name, u.pw_gid)
    os.setgid(u.pw_gid)
    os.setuid(u.pw_uid)
if os.getuid() == 0 or os.geteuid() == 0:
    sys.exit("rebot-app-run: refusing to run the program as root")
os.environ.update(HOME=u.pw_dir, USER=u.pw_name, LOGNAME=u.pw_name)
os.execvp(sys.argv[2], sys.argv[2:])'

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [rebot-app-run] $*" >> "$LOG" 2>/dev/null; }

# write_state <state>: atomic replace of the state file
write_state() {
    {
        echo "state=$1"
        echo "pid=$child"
        echo "runner=$$"
        echo "starts=$total"
        echo "last_exit=$last_exit"
    } > "$STATE.tmp" 2>/dev/null && mv -f "$STATE.tmp" "$STATE" 2>/dev/null
}

# Copy the log to .1 (shifting .1 to .2) and truncate it when it is larger than LOG_MAX.
rotate_log() {
    [ -f "$LOG" ] || return 0
    size=$(wc -c < "$LOG" 2>/dev/null)
    [ -n "$size" ] && [ "$size" -gt "$LOG_MAX" ] || return 0
    [ -f "$LOG.1" ] && mv -f "$LOG.1" "$LOG.2"
    cp -f "$LOG" "$LOG.1" && : > "$LOG"
}

# Background: rotate_log every LOG_CHECK seconds while the program runs.
rotate_loop() {
    while :; do
        sleep "$LOG_CHECK"
        rotate_log
    done
}

on_term() {
    stopping=1
    [ -n "$sleeper" ] && kill -TERM "$sleeper" 2>/dev/null
    if [ -n "$child" ]; then
        # the group (pgid = program pid) exists once the launcher ran setsid
        kill -TERM "-$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null
        if [ -z "$killer" ]; then
            ( sleep "$KILL_GRACE"; kill -KILL "-$child" 2>/dev/null || kill -KILL "$child" 2>/dev/null ) &
            killer=$!
        fi
    fi
}

# check_user: the program user exists, is not root, and this runner can switch to it.
check_user() {
    uid=$(id -u "$RUN_USER" 2>/dev/null) || { log "user $RUN_USER does not exist; not starting (set REBOT_APP_USER)"; return 1; }
    [ "$uid" -ne 0 ] || { log "user $RUN_USER is root; not starting"; return 1; }
    me=$(id -u)
    if [ "$me" -ne 0 ] && [ "$me" -ne "$uid" ]; then
        log "runner is not root and cannot run the program as $RUN_USER; not starting"
        return 1
    fi
    command -v python3 >/dev/null 2>&1 || { log "python3 not found; not starting"; return 1; }
}

# Wait until the program ($child) has exited; its status in rc (see rebot-vision-run).
wait_child() {
    rc=0
    while :; do
        wait "$child"
        rc=$?
        [ "$rc" -eq 127 ] && break
        kill -0 "$child" 2>/dev/null || break
        sleep 0.2
    done
}

# Read entry and restart from app.json (python3 only; main.py / on-failure without it).
read_manifest() {
    entry=main.py
    restart=on-failure
    [ -f "$APP_DIR/app.json" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    out=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    e = d.get('entry')
    r = d.get('restart')
    if isinstance(e, str) and e: print('entry=' + e.replace(' ', ''))
    if r in ('on-failure', 'always', 'never'): print('restart=' + r)
except Exception:
    pass
" "$APP_DIR/app.json" 2>/dev/null)
    for kv in $out; do
        case "$kv" in
            entry=*) entry=${kv#entry=} ;;
            restart=*) restart=${kv#restart=} ;;
        esac
    done
}

main() {
    NAME=$1
    case "$NAME" in
        ''|*[!A-Za-z0-9._-]*|.|..) echo "usage: rebot-app-run <app-name> (letters, digits, . _ -)" >&2; return 2 ;;
    esac
    APP_DIR=$APPS_DIR/$NAME
    mkdir -p "$LOG_DIR" "$STATE_DIR" 2>/dev/null
    LOG=$LOG_DIR/app-$NAME.log
    STATE=$STATE_DIR/rebot-app-$NAME.state
    child=""
    killer=""
    sleeper=""
    total=0
    last_exit=""
    stopping=0

    if [ ! -d "$APP_DIR" ]; then
        log "app directory $APP_DIR does not exist"
        write_state stopped
        return 1
    fi
    read_manifest
    case "$entry" in
        /*|*..*) log "entry $entry is not a path inside $APP_DIR"; write_state stopped; return 1 ;;
    esac
    if [ ! -f "$APP_DIR/$entry" ]; then
        log "entry $APP_DIR/$entry does not exist"
        write_state stopped
        return 1
    fi

    if ! check_user; then
        write_state stopped
        return 1
    fi

    NICE="nice -n 5"
    command -v nice >/dev/null 2>&1 || NICE=""
    export REBOT_HOST=127.0.0.1
    export PYTHONPATH="$SDK_PATH:$APP_DIR"
    trap on_term TERM INT

    rotate_loop &
    rotator=$!
    log "starting $NAME (entry $entry, restart $restart, user $RUN_USER)"

    starts=""
    delay=1
    result=0
    while [ "$stopping" -eq 0 ]; do
        now=$(date +%s)
        recent=""
        n=0
        for s in $starts; do
            if [ $((now - s)) -lt "$GIVEUP_WINDOW" ]; then recent="$recent $s"; n=$((n + 1)); fi
        done
        starts="$recent"
        if [ "$n" -ge "$GIVEUP_STARTS" ]; then
            log "$GIVEUP_STARTS starts within $GIVEUP_WINDOW s; giving up (see the messages above)"
            write_state given_up
            result=1
            break
        fi
        starts="$starts $now"
        rotate_log
        cd "$APP_DIR" || { log "cannot enter $APP_DIR"; write_state stopped; result=1; break; }
        $NICE python3 -c "$LAUNCH" "$RUN_USER" "$PYTHON" -u "$entry" >> "$LOG" 2>&1 < /dev/null &
        child=$!
        total=$((total + 1))
        # a SIGTERM between the fork and the line above found no child to forward to
        [ "$stopping" -eq 1 ] && on_term
        write_state running
        wait_child
        last_exit=$rc
        # processes the program left in its group
        kill -KILL "-$child" 2>/dev/null
        [ -n "$killer" ] && { kill -TERM "$killer" 2>/dev/null; killer=""; }
        child=""
        if [ "$stopping" -eq 1 ]; then break; fi
        if [ "$rc" -eq 0 ] && [ "$restart" != always ]; then
            log "exited (0); not restarting (restart=$restart)"
            break
        fi
        if [ "$restart" = never ]; then
            log "exited ($rc); not restarting (restart=never)"
            break
        fi
        if [ $(( $(date +%s) - now )) -gt "$STABLE_SECS" ]; then delay=1; fi
        log "exited ($rc); restarting in ${delay}s"
        write_state backoff
        sleep "$delay" &
        sleeper=$!
        wait "$sleeper"
        sleeper=""
        delay=$((delay * 2))
        [ "$delay" -gt "$BACKOFF_MAX" ] && delay=$BACKOFF_MAX
    done
    kill -TERM "$rotator" 2>/dev/null
    [ "$result" -eq 0 ] && write_state stopped
    [ "$stopping" -eq 1 ] && log "stopped"
    return "$result"
}

main "$@"; exit $?
