#!/bin/sh
### BEGIN INIT INFO
# Provides:          rebot-teleop
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: reBot Teleop and Robotic Arm Daemon for reCamera
### END INIT INFO

# Starts armd (arm control, cockpit on :8765) and rebot-vision (camera: H.264 on :8001,
# YOLO / ArUco API on :8090). The arm is the app: start/status/stop results follow armd;
# vision failing to start is logged and leaves armd running.

NAME=rebot-teleop
DAEMON=/usr/local/bin/armd
PIDFILE=/var/run/$NAME.pid
LOGFILE=/var/log/$NAME.log
# armd also writes a rotating log (armd.log) and its black box (bb.jsonl, boots.log) on
# /userdata, which survive a reboot (armd --log-dir / --blackbox-dir defaults)
PERSIST_LOG_DIR=/userdata/rebot-teleop/logs
BLACKBOX_DIR=/userdata/rebot-teleop/blackbox
# B601-DM arm profile (kit data, equal to armd's built-in rebot-dm profile)
PROFILE=/usr/share/$NAME/profile/rebot-b601dm.json

# Camera process, kept running by a respawn loop whose pid is in VISION_PIDFILE
VISION_DAEMON=/usr/bin/rebot-vision
VISION_RUNNER=/usr/share/$NAME/rebot-vision-run
VISION_PIDFILE=/var/run/rebot-vision.pid
VISION_CONF=/userdata/rebot-teleop/vision.json
VISION_CONF_DEFAULT=/usr/share/$NAME/vision.json.default
VISION_STOP_TICKS=40  # stop_vision waits up to 40 x 0.25 s for rebot-vision to exit
# User program (rebot-app-run keeps /userdata/rebot-apps/<name>/main.py running), started
# after armd when the config has app.enabled true and app.name set
APP_RUNNER=/usr/share/$NAME/rebot-app-run
APP_PIDFILE=/var/run/rebot-app.pid
APP_NAMEFILE=/var/run/rebot-app.name
APP_DIR_BASE=/userdata/rebot-apps
APP_STOP_TICKS=60  # stop_app waits up to 60 x 0.25 s (the runner sends SIGKILL after 10 s)
APP_ENABLED=""
APP_NAME=""
# Gallery apps that hold the camera. Only ones running from their own pidfile are stopped,
# with their own init script; nothing is disabled or uninstalled.
CAMERA_APPS="yolo-detector aruco-detector face-analysis face-recognition detection-blur ppocr-reader retail-vision qrcode-reader trigger-inspection-demo microduck-pose-qa fall-detection"

# reCamera console (supervisor): its app registry, read by app_restore at boot
SUPERVISOR_MAIN=/usr/share/supervisor/scripts/main.sh
APPS_STATE=/userdata/local/apps/state.json
INIT_SCRIPT=/etc/init.d/K92$NAME

# Our hotspot hostapd, and the guard that keeps it against the console's boot hotspot
AP_CONF=/var/run/hostapd_arm.conf
AP_PIDFILE=/var/run/hostapd_arm.pid
AP_GUARD_PIDFILE=/var/run/rebot-teleop-apguard.pid
AP_GUARD_TICKS=30  # x 2 s

# 默认配置参数
FOLLOWER_MODEL="rebot-dm"
FOLLOWER_PORT="can0"
PORT="8765"
AP_SSID="reCamera-Arm-Teleop"
AP_PASS="12345678"
AP_IP="192.168.16.1"
AP_BAND="5g"     # 5g | 2g4
AP_CHANNEL=""    # empty: 44 on 5g, 6 on 2g4
STA_SSID=""
STA_PASS=""

# 读取 supervisor 或系统覆盖配置
CONFIG_JSON="/userdata/local/apps/$NAME.config.json"
if [ -f "$CONFIG_JSON" ] && which python3 >/dev/null 2>&1; then
    eval $(python3 -c "
import json
try:
    with open('$CONFIG_JSON') as f:
        cfg = json.load(f)
    arm = cfg.get('arm', {})
    net = cfg.get('network', {})
    app = cfg.get('app', {})
    if 'follower_model' in arm and arm['follower_model']: print(f\"FOLLOWER_MODEL='{arm['follower_model']}'\")
    if 'serial_port' in arm and arm['serial_port']: print(f\"FOLLOWER_PORT='{arm['serial_port']}'\")
    if 'port' in cfg and cfg['port']: print(f\"PORT='{cfg['port']}'\")
    if 'ap_ssid' in net and net['ap_ssid']: print(f\"AP_SSID='{net['ap_ssid']}'\")
    if 'ap_password' in net and net['ap_password']: print(f\"AP_PASS='{net['ap_password']}'\")
    if 'ap_ip' in net and net['ap_ip']: print(f\"AP_IP='{net['ap_ip']}'\")
    if net.get('ap_band') in ('5g', '2g4'): print(f\"AP_BAND='{net['ap_band']}'\")
    if str(net.get('ap_channel', '')).isdigit() and int(net['ap_channel']) > 0: print(f\"AP_CHANNEL='{int(net['ap_channel'])}'\")
    if 'sta_ssid' in net: print(f\"STA_SSID='{net['sta_ssid']}'\")
    if 'sta_password' in net: print(f\"STA_PASS='{net['sta_password']}'\")
    import re
    if app.get('enabled') in (True, 'true', 'True', 1, '1'): print(\"APP_ENABLED='1'\")
    if isinstance(app.get('name'), str) and re.fullmatch(r'[A-Za-z0-9._-]+', app['name']) and app['name'] not in ('.', '..'): print(f\"APP_NAME='{app['name']}'\")
except Exception:
    pass
" 2>/dev/null)
fi

# Write the hostapd config for band $1 (5g | 2g4) on channel $2 and start hostapd.
# Succeeds when our hostapd (AP_PIDFILE) is running and `iw dev wlan1 info` reports that channel.
start_ap() {
    if [ "$1" = "5g" ]; then
        AP_HW="hw_mode=a
channel=$2
ieee80211n=1
ieee80211ac=1"
        AP_BAND_LABEL="5 GHz"
    else
        AP_HW="hw_mode=g
channel=$2
ieee80211n=1"
        AP_BAND_LABEL="2.4 GHz"
    fi
    echo "[rebot-teleop] Starting Wi-Fi AP Hotspot (SSID: $AP_SSID on wlan1, $AP_BAND_LABEL channel $2)..."
    cat <<EOT > "$AP_CONF"
interface=wlan1
driver=nl80211
ssid=$AP_SSID
$AP_HW
wmm_enabled=1
macaddr_acl=0
auth_algs=1
wpa=2
wpa_passphrase=$AP_PASS
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
EOT

    # hostapd 参数 -B 必须置于配置文件路径之前
    rm -f "$AP_PIDFILE"
    hostapd -B -P "$AP_PIDFILE" "$AP_CONF" >/dev/null 2>&1 || true
    w=0
    while [ $w -lt 6 ]; do
        sleep 0.5
        own_ap_pid >/dev/null || return 1
        iw dev wlan1 info 2>/dev/null | grep -q "channel $2 " && return 0
        w=$((w + 1))
    done
    return 1
}

# Command line of process $1, NULs as spaces.
proc_cmdline() {
    tr '\000' ' ' < "/proc/$1/cmdline" 2>/dev/null
}

# PID of our hostapd: the one in AP_PIDFILE, running with AP_CONF.
own_ap_pid() {
    OPID=$(cat "$AP_PIDFILE" 2>/dev/null)
    case "$OPID" in ''|*[!0-9]*) return 1 ;; esac
    [ -d "/proc/$OPID" ] || return 1
    case "$(proc_cmdline "$OPID")" in *hostapd*"$AP_CONF"*) echo "$OPID" ;; *) return 1 ;; esac
}

# PIDs of hostapd processes the reCamera console started (/etc/hostapd_2g4.conf or
# /etc/hostapd_5g.conf, its system hotspot reCamera_XXXXXX).
console_ap_pids() {
    for HPID in $(pidof hostapd 2>/dev/null); do
        case "$(proc_cmdline "$HPID")" in
            *hostapd_2g4.conf*|*hostapd_5g.conf*) echo "$HPID" ;;
        esac
    done
}

# PIDs of hostapd processes that are neither ours nor the console's. Never signalled.
other_ap_pids() {
    OWN=$(own_ap_pid)
    for HPID in $(pidof hostapd 2>/dev/null); do
        [ "$HPID" = "$OWN" ] && continue
        case "$(proc_cmdline "$HPID")" in
            *hostapd_2g4.conf*|*hostapd_5g.conf*) ;;
            *) echo "$HPID" ;;
        esac
    done
}

# Stop the console's hostapd only (SIGTERM, up to 2 s, then SIGKILL), so our AP can use
# wlan1. Returns 0 when one was stopped. $1 says when, for the log.
stop_console_ap() {
    CPIDS=$(console_ap_pids)
    [ -n "$CPIDS" ] || return 1
    for CPID in $CPIDS; do
        CCMD=$(proc_cmdline "$CPID")
        kill -TERM "$CPID" 2>/dev/null || true
        k=0
        while [ "$k" -lt 8 ] && [ -d "/proc/$CPID" ]; do sleep 0.25; k=$((k + 1)); done
        if [ -d "/proc/$CPID" ]; then
            kill -KILL "$CPID" 2>/dev/null || true
            k=0
            while [ "$k" -lt 4 ] && [ -d "/proc/$CPID" ]; do sleep 0.25; k=$((k + 1)); done
        fi
        echo "[rebot-teleop] stopped the console's hotspot (hostapd PID $CPID) $1"
        logger -t "$NAME" "AP takeover $1: stopped the console's hostapd (PID $CPID: $CCMD)" 2>/dev/null || true
    done
    return 0
}

# Restart dnsmasq so wlan1 gets DHCP (graceful stop with retries, against the cold-boot race).
restart_dnsmasq() {
    start-stop-daemon -K -p /var/run/dnsmasq.pid -s TERM 2>/dev/null || killall -TERM dnsmasq 2>/dev/null || true
    w=0
    while [ $w -lt 4 ] && pidof dnsmasq >/dev/null 2>&1; do sleep 0.25; w=$((w + 1)); done
    if pidof dnsmasq >/dev/null 2>&1; then killall -9 dnsmasq 2>/dev/null || true; sleep 0.2; fi
    if [ -f /etc/dnsmasq/usb_wlan1.conf ]; then
        /usr/sbin/dnsmasq -C /etc/dnsmasq/usb_wlan1.conf >/dev/null 2>&1 || true
    elif [ -f /etc/init.d/S80dnsmasq ]; then
        /etc/init.d/S80dnsmasq start >/dev/null 2>&1 || true
    fi
}

# Start our AP on the configured band; 5 GHz falls back to 2.4 GHz channel 6. Sets
# AP_RUN_BAND / AP_RUN_CHANNEL to what was started.
start_own_ap() {
    AP_RUN_BAND="$AP_BAND"
    if [ "$AP_BAND" = "2g4" ]; then
        AP_RUN_CHANNEL="${AP_CHANNEL:-6}"
        start_ap 2g4 "$AP_RUN_CHANNEL" || true
    else
        AP_RUN_CHANNEL="${AP_CHANNEL:-44}"
        if ! start_ap 5g "$AP_RUN_CHANNEL"; then
            echo "[rebot-teleop] 5 GHz AP did not come up on channel $AP_RUN_CHANNEL; falling back to 2.4 GHz channel 6"
            logger -t "$NAME" "5 GHz AP failed on channel $AP_RUN_CHANNEL; fell back to 2.4 GHz channel 6" 2>/dev/null || true
            stop_own_ap
            AP_RUN_BAND=2g4
            AP_RUN_CHANNEL=6
            start_ap 2g4 6 || true
        fi
    fi
    ifconfig wlan1 "$AP_IP" netmask 255.255.255.0 up 2>/dev/null || true
}

# Stop only our hostapd (its pidfile and config), SIGTERM.
stop_own_ap() {
    if OPID=$(own_ap_pid); then
        kill -TERM "$OPID" 2>/dev/null || true
        k=0
        while [ "$k" -lt 4 ] && [ -d "/proc/$OPID" ]; do sleep 0.25; k=$((k + 1)); done
    fi
    rm -f "$AP_PIDFILE"
}

# Background guard for the boot race (the console can start its hotspot just after ours):
# every 2 s for AP_GUARD_TICKS ticks, stop a console hostapd that appeared and restart ours
# (band $1, channel $2) when it is no longer running or no longer on its channel.
ap_guard() {
    t=0
    off=0
    while [ "$t" -lt "${AP_GUARD_TICKS:-30}" ]; do
        sleep 2
        t=$((t + 1))
        changed=0
        stop_console_ap "after boot (guard)" && changed=1
        if ! own_ap_pid >/dev/null; then
            off=2
        elif iw dev wlan1 info 2>/dev/null | grep -q "channel $2 "; then
            off=0
        else
            off=$((off + 1))
        fi
        # a hostapd that is not ours or the console's owns wlan1: leave it
        if [ "$off" -ge 2 ] && [ -z "$(other_ap_pids)" ]; then
            echo "[rebot-teleop] our hotspot is down; restarting it"
            logger -t "$NAME" "AP guard: our hostapd was not running on channel $2; restarting it" 2>/dev/null || true
            stop_own_ap
            start_ap "$1" "$2" || true
            ifconfig wlan1 "$AP_IP" netmask 255.255.255.0 up 2>/dev/null || true
            changed=1
            off=0
        fi
        [ "$changed" -eq 1 ] && restart_dnsmasq
    done
    rm -f "$AP_GUARD_PIDFILE"
}

# Stop the AP guard from its pidfile if that process is the guard.
stop_ap_guard() {
    GPID=$(cat "$AP_GUARD_PIDFILE" 2>/dev/null)
    case "$GPID" in ''|*[!0-9]*) rm -f "$AP_GUARD_PIDFILE"; return 0 ;; esac
    case "$(proc_cmdline "$GPID")" in
        *ap-guard*) kill -TERM "$GPID" 2>/dev/null || true ;;
    esac
    rm -f "$AP_GUARD_PIDFILE"
    return 0
}

start_ap_guard() {
    stop_ap_guard
    start-stop-daemon -S -b -m -p "$AP_GUARD_PIDFILE" -a /bin/sh -- "$INIT_SCRIPT" ap-guard "$1" "$2" >/dev/null 2>&1 || true
}

start_wifi() {
    # 1. 启动 STA 外部 WiFi（如果配置了 sta_ssid）
    if [ -n "$STA_SSID" ]; then
        echo "[rebot-teleop] Connecting to external Wi-Fi: $STA_SSID..."
        if ! pidof wpa_supplicant >/dev/null 2>&1; then
            wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf >/dev/null 2>&1 || true
            sleep 1
        fi
        NID=$(wpa_cli -i wlan0 add_network 2>/dev/null | tail -n 1)
        if [ -n "$NID" ] && [ "$NID" -ge 0 ] 2>/dev/null; then
            wpa_cli -i wlan0 set_network "$NID" ssid "\"$STA_SSID\"" >/dev/null 2>&1 || true
            if [ -n "$STA_PASS" ]; then
                wpa_cli -i wlan0 set_network "$NID" psk "\"$STA_PASS\"" >/dev/null 2>&1 || true
            else
                wpa_cli -i wlan0 set_network "$NID" key_mgmt NONE >/dev/null 2>&1 || true
            fi
            wpa_cli -i wlan0 enable_network "$NID" >/dev/null 2>&1 || true
            wpa_cli -i wlan0 select_network "$NID" >/dev/null 2>&1 || true
        fi
    fi

    # 2. 确保虚拟网卡 wlan1 存在
    if [ -z "$(ifconfig wlan1 2>/dev/null)" ] && [ -n "$(ifconfig wlan0 2>/dev/null)" ]; then
        iw dev wlan0 interface add wlan1 type __ap 2>/dev/null || true
    fi

    # 3. 启动 AP 热点（绑定在 wlan1 上）；5 GHz 起不来时回退到 2.4 GHz 信道 6。
    # The console starts its own hotspot (hostapd_2g4/5g.conf) at boot when no hostapd runs;
    # that one is stopped for ours. A hostapd that is neither is left alone.
    stop_console_ap "at start" || true
    if own_ap_pid >/dev/null; then
        echo "[rebot-teleop] Wi-Fi AP hotspot already running (PID: $(own_ap_pid))"
    elif [ -n "$(other_ap_pids)" ]; then
        echo "[rebot-teleop] another hostapd runs on this device (PID: $(other_ap_pids | tr '\n' ' ')); AP not started"
        logger -t "$NAME" "AP not started: hostapd $(other_ap_pids | tr '\n' ' ')is not ours or the console's" 2>/dev/null || true
    else
        start_own_ap
        restart_dnsmasq
        start_ap_guard "$AP_RUN_BAND" "$AP_RUN_CHANNEL"
    fi
}

# PID of the vision respawn loop from its pidfile, if that process is the loop.
vision_pid() {
    VPID=$(cat "$VISION_PIDFILE" 2>/dev/null)
    case "$VPID" in ''|*[!0-9]*) return 1 ;; esac
    [ -d "/proc/$VPID" ] || return 1
    tr '\000' ' ' < "/proc/$VPID/cmdline" 2>/dev/null | grep -q "$VISION_RUNNER" || return 1
    echo "$VPID"
}

# Stop gallery apps that currently hold the camera (running from their pidfile).
stop_camera_holders() {
    STOPPED=""
    for app in $CAMERA_APPS; do
        APID=$(cat "/var/run/$app.pid" 2>/dev/null)
        case "$APID" in ''|*[!0-9]*) continue ;; esac
        [ -d "/proc/$APID" ] || continue
        for script in /etc/init.d/[SK]??"$app"; do
            [ -x "$script" ] || continue
            "$script" stop >/dev/null 2>&1 || true
            echo "[rebot-teleop] stopped camera holder $app"
            logger -t "$NAME" "stopped camera holder $app" 2>/dev/null || true
            STOPPED="$STOPPED $app"
            break
        done
    done
    # VPSS needs a moment to release the camera, as the console waits between apps
    [ -n "$STOPPED" ] && sleep 2
    return 0
}

# Record rebot-teleop as the console's active app in state.json (active_app, active_script,
# updated_at; every other field, e.g. models, is kept), as the console does after a switch,
# so app_restore starts this app at boot and not the camera app that was active before.
# Written with the console's app_write_state (atomic tmp + sync + rename; its one argument
# after the function name is the JSON). No-op without the console or when already recorded.
register_active_app() {
    [ -x "$SUPERVISOR_MAIN" ] || return 0
    STATE='{"active_app": null, "active_script": null, "models": {}, "updated_at": 0}'
    if [ -s "$APPS_STATE" ] && grep -q '{' "$APPS_STATE"; then
        STATE=$(cat "$APPS_STATE")
    fi
    if printf '%s\n' "$STATE" | grep -q "\"active_app\"[[:space:]]*:[[:space:]]*\"$NAME\"" &&
        printf '%s\n' "$STATE" | grep -q "\"active_script\"[[:space:]]*:[[:space:]]*\"$INIT_SCRIPT\""; then
        return 0
    fi
    NEW=$(printf '%s\n' "$STATE" | sed \
        -e "s|\"active_app\"[[:space:]]*:[[:space:]]*null|\"active_app\": \"$NAME\"|" \
        -e "s|\"active_app\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"active_app\": \"$NAME\"|" \
        -e "s|\"active_script\"[[:space:]]*:[[:space:]]*null|\"active_script\": \"$INIT_SCRIPT\"|" \
        -e "s|\"active_script\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"active_script\": \"$INIT_SCRIPT\"|" \
        -e "s|\"updated_at\"[[:space:]]*:[[:space:]]*[0-9][0-9]*|\"updated_at\": $(date +%s)|")
    # keys the file does not have yet go first in the object
    for kv in "active_script:$INIT_SCRIPT" "active_app:$NAME"; do
        k=${kv%%:*}
        printf '%s\n' "$NEW" | grep -q "\"$k\"" && continue
        NEW=$(printf '%s\n' "$NEW" | awk -v ins="\"$k\": \"${kv#*:}\", " \
            '!done && sub(/\{/, "{" ins) { done = 1; sub(/, *\}/, "}") } { print }')
    done
    if command -v bash >/dev/null 2>&1 && [ "$(bash "$SUPERVISOR_MAIN" app_write_state "$NEW" 2>/dev/null)" = OK ]; then
        :
    else
        # same write as app_write_state when it is unavailable
        TMP="$(dirname "$APPS_STATE")/.state.json.tmp"
        if ! { mkdir -p "$(dirname "$APPS_STATE")" && printf '%s' "$NEW" > "$TMP" && sync && mv -f "$TMP" "$APPS_STATE"; }; then
            rm -f "$TMP"
            echo "[rebot-teleop] could not record $NAME as the console's active app"
            return 1
        fi
    fi
    echo "[rebot-teleop] recorded $NAME as the console's active app"
    logger -t "$NAME" "recorded as the console's active app in $APPS_STATE" 2>/dev/null || true
    return 0
}

# PID of the app runner from its pidfile, if that process is the runner.
app_pid() {
    APID=$(cat "$APP_PIDFILE" 2>/dev/null)
    case "$APID" in ''|*[!0-9]*) return 1 ;; esac
    [ -d "/proc/$APID" ] || return 1
    tr '\000' ' ' < "/proc/$APID/cmdline" 2>/dev/null | grep -q "$APP_RUNNER" || return 1
    echo "$APID"
}

# app-start [name]: run /userdata/rebot-apps/<name> under rebot-app-run (name: argument, else
# app.name of the config). Never fails the app start; returns 1 for a manual app-start that
# could not start.
start_app() {
    ANAME=${1:-$APP_NAME}
    if [ -z "$ANAME" ]; then
        echo "[rebot-teleop] no app name (give one, or set app.name in the config)"
        return 1
    fi
    case "$ANAME" in
        *[!A-Za-z0-9._-]*|.|..) echo "[rebot-teleop] invalid app name: $ANAME"; return 1 ;;
    esac
    if [ ! -f "$APP_RUNNER" ]; then
        echo "[rebot-teleop] $APP_RUNNER not installed"
        return 1
    fi
    if [ ! -d "$APP_DIR_BASE/$ANAME" ]; then
        echo "[rebot-teleop] $APP_DIR_BASE/$ANAME does not exist"
        return 1
    fi
    if APID=$(app_pid); then
        echo "[rebot-teleop] app $(cat "$APP_NAMEFILE" 2>/dev/null) is already running (PID: $APID); app-stop first"
        return 1
    fi
    rm -f "$APP_PIDFILE"
    echo "$ANAME" > "$APP_NAMEFILE"
    start-stop-daemon -S -b -m -p "$APP_PIDFILE" -a /bin/sh -- "$APP_RUNNER" "$ANAME"
    sleep 0.5
    if APID=$(app_pid); then
        echo "[rebot-teleop] app $ANAME started (PID: $APID, log $PERSIST_LOG_DIR/app-$ANAME.log)"
    else
        echo "[rebot-teleop] app $ANAME did not start; see $PERSIST_LOG_DIR/app-$ANAME.log"
        return 1
    fi
    return 0
}

# Stop the app runner: SIGTERM; it forwards SIGTERM to the program and sends SIGKILL after
# 10 s. A pidfile naming another process is left alone.
stop_app() {
    [ -f "$APP_PIDFILE" ] || return 0
    APID=$(cat "$APP_PIDFILE" 2>/dev/null)
    case "$APID" in ''|*[!0-9]*) rm -f "$APP_PIDFILE"; return 0 ;; esac
    if [ ! -d "/proc/$APID" ]; then rm -f "$APP_PIDFILE"; return 0; fi
    if ! tr '\000' ' ' < "/proc/$APID/cmdline" 2>/dev/null | grep -q "$APP_RUNNER"; then
        echo "PID $APID is not $APP_RUNNER; leaving it"
        return 0
    fi
    kill -TERM "$APID" 2>/dev/null || true
    w=0
    while [ "$w" -lt "$APP_STOP_TICKS" ] && proc_alive "$APID"; do sleep 0.25; w=$((w + 1)); done
    if proc_alive "$APID"; then
        echo "app runner still stopping (PID $APID)"
    else
        rm -f "$APP_PIDFILE"
        echo "app stopped"
    fi
    return 0
}

app_status() {
    ANAME=$(cat "$APP_NAMEFILE" 2>/dev/null)
    if APID=$(app_pid); then
        echo "app $ANAME runner is running (PID: $APID)"
        cat "/tmp/rebot-app-$ANAME.state" 2>/dev/null
        return 0
    fi
    echo "app runner is not running"
    [ -n "$ANAME" ] && cat "/tmp/rebot-app-$ANAME.state" 2>/dev/null
    return 1
}

# app-logs [n]: last n lines (default 50) of the log of the current (or last) app
app_logs() {
    ANAME=$(cat "$APP_NAMEFILE" 2>/dev/null)
    [ -n "$ANAME" ] || ANAME=$APP_NAME
    if [ -z "$ANAME" ] || [ ! -f "$PERSIST_LOG_DIR/app-$ANAME.log" ]; then
        echo "no app log"
        return 1
    fi
    case "${1:-50}" in ''|*[!0-9]*) echo "usage: app-logs [n]"; return 1 ;; esac
    tail -n "${1:-50}" "$PERSIST_LOG_DIR/app-$ANAME.log"
}

port_busy() {
    command -v netstat >/dev/null 2>&1 || return 1
    netstat -ltn 2>/dev/null | grep -q "[:.]$1 "
}

# Start rebot-vision under its respawn loop at nice 10. Never fails the app start.
start_vision() {
    if [ ! -x "$VISION_DAEMON" ] || [ ! -f "$VISION_RUNNER" ]; then
        echo "[rebot-teleop] rebot-vision not installed; camera features unavailable"
        return 0
    fi
    if VPID=$(vision_pid); then
        # A loop always has a child (rebot-vision, or sleep between restarts). One without a
        # child for 1 s is hung (see stop_vision): stop it and start a new one.
        c=0
        while [ "$c" -lt 4 ] && ! has_child "$VPID"; do sleep 0.25; c=$((c + 1)); done
        if [ "$c" -lt 4 ]; then
            echo "[rebot-teleop] rebot-vision is already running (PID: $VPID)"
            return 0
        fi
        echo "[rebot-teleop] rebot-vision loop (PID: $VPID) has no child; restarting it"
        stop_vision
        if vision_pid >/dev/null; then
            echo "[rebot-teleop] rebot-vision loop (PID: $VPID) did not stop; rebot-vision not started"
            return 0
        fi
    fi
    rm -f "$VISION_PIDFILE"
    stop_camera_holders
    for port in 8001 8090; do
        if port_busy "$port"; then
            echo "[rebot-teleop] port $port is in use by another program; rebot-vision not started"
            logger -t "$NAME" "port $port busy ($(netstat -ltnp 2>/dev/null | grep "[:.]$port " | head -n 1)); rebot-vision not started" 2>/dev/null || true
            return 0
        fi
    done
    if [ ! -f "$VISION_CONF" ] && [ -f "$VISION_CONF_DEFAULT" ]; then
        mkdir -p "$(dirname "$VISION_CONF")" && cp -f "$VISION_CONF_DEFAULT" "$VISION_CONF" 2>/dev/null || true
    fi
    REBOT_VISION_CONF="$VISION_CONF" start-stop-daemon -S -b -m -p "$VISION_PIDFILE" -a /bin/sh -- "$VISION_RUNNER"
    sleep 0.5
    if VPID=$(vision_pid); then
        echo "[rebot-teleop] rebot-vision started (PID: $VPID, log /var/log/rebot-vision.log)"
    else
        echo "[rebot-teleop] rebot-vision did not start; see /var/log/rebot-vision.log"
    fi
    return 0
}

start() {
    echo "Starting $NAME..."
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE 2>/dev/null)
        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
            # armd already up (boot S92 then a console switch, or app_restore): make sure vision runs too
            echo "$NAME is already running (PID: $PID)"
            start_vision
            if [ "$APP_ENABLED" = 1 ] && [ -n "$APP_NAME" ] && ! app_pid >/dev/null; then start_app || true; fi
            register_active_app || true
            return 0
        fi
        rm -f $PIDFILE
    fi

    # Do not reconfigure CAN/network while an untracked controller may still hold an arm.
    if ! command -v pidof >/dev/null 2>&1 || pidof armd >/dev/null 2>&1; then
        echo "Cannot start: an armd process is untracked or process discovery is unavailable"
        return 1
    fi

    # 启动 WiFi (STA 外部连接 + AP 热点双并发)
    start_wifi

    # 探测实际端口与 CAN 总线初始化
    if [ "$FOLLOWER_PORT" = "can0" ]; then
        echo "[rebot-teleop] Ensuring can0 interface is up (1Mbps, restart-ms 100, qlen 1000)..."
        ip link set can0 down 2>/dev/null || true
        ip link set can0 type can bitrate 1000000 restart-ms 100 2>/dev/null || true
        ip link set can0 txqueuelen 1000 2>/dev/null || true
        ip link set can0 up 2>/dev/null || true
    elif [ ! -e "$FOLLOWER_PORT" ]; then
        if [ -e "/dev/ttyUSB0" ]; then
            FOLLOWER_PORT="/dev/ttyUSB0"
        elif [ -e "/dev/ttyACM0" ]; then
            FOLLOWER_PORT="/dev/ttyACM0"
        fi
    fi

    DAEMON_OPTS="--follower $FOLLOWER_MODEL --follower-port $FOLLOWER_PORT --port $PORT"
    # The profile is for the 7-joint B601-DM only; other followers keep their built-in profile.
    if [ "$FOLLOWER_MODEL" = "rebot-dm" ] && [ -f "$PROFILE" ]; then
        DAEMON_OPTS="$DAEMON_OPTS --config $PROFILE"
    fi

    # armd runs as root; it falls back to stdout only when these cannot be written
    mkdir -p "$PERSIST_LOG_DIR" "$BLACKBOX_DIR" 2>/dev/null || true
    DAEMON_OPTS="$DAEMON_OPTS --log-dir $PERSIST_LOG_DIR --blackbox-dir $BLACKBOX_DIR"

    start-stop-daemon -S -b -m -p $PIDFILE -a /bin/sh -- -c "exec $DAEMON $DAEMON_OPTS >> $LOGFILE 2>&1"
    if [ $? -ne 0 ]; then
        echo "$NAME failed to start (start-stop-daemon error)"
        rm -f $PIDFILE
        return 1
    fi

    # 稳定性验证
    sleep 1
    i=0
    while [ $i -lt 3 ]; do
        PID=$(cat $PIDFILE 2>/dev/null)
        if [ -z "$PID" ] || [ ! -d "/proc/$PID" ]; then
            echo "$NAME exited immediately after start"
            rm -f $PIDFILE
            return 1
        fi
        sleep 0.5
        i=$((i + 1))
    done

    echo "OK"

    # 停止旧版本遗留的 go2rtc（视频已改由摄像头 WebSocket 直出）
    stop_video

    start_vision
    if [ "$APP_ENABLED" = 1 ] && [ -n "$APP_NAME" ]; then start_app || true; fi
    register_active_app || true
    return 0
}

# Stop only the video process owned by this application's pidfile: the go2rtc
# that older packages started. Best effort, SIGTERM only.
stop_video() {
    VIDEO_PIDFILE=/var/run/go2rtc.pid
    if [ -f "$VIDEO_PIDFILE" ]; then
        VIDEO_PID=$(cat "$VIDEO_PIDFILE" 2>/dev/null)
        case "$VIDEO_PID" in ''|*[!0-9]*) return 0 ;; esac
        # The upgrade removes the binary, so a leftover process reports "(deleted)".
        if [ "$(readlink "/proc/$VIDEO_PID/exe" 2>/dev/null | sed 's/ (deleted)$//')" = /usr/local/bin/go2rtc ]; then
            kill -TERM "$VIDEO_PID" 2>/dev/null || true
            rm -f "$VIDEO_PIDFILE"
        elif [ ! -d "/proc/$VIDEO_PID" ]; then
            rm -f "$VIDEO_PIDFILE"
        fi
    fi
}

# A process whose parent is $1 (a TGID under /proc; threads are not listed there).
has_child() {
    grep -qs "^PPid:[[:space:]]*$1\$" /proc/[0-9]*/status
}

# Process $1 exists and has not exited (a zombie waiting for its parent counts as exited).
proc_alive() {
    [ -d "/proc/$1" ] && ! grep -qs "^State:[[:space:]]*Z" "/proc/$1/status"
}

# Stop the vision respawn loop from its pidfile: SIGTERM, which the loop forwards to
# rebot-vision before it exits. rebot-vision may take a few seconds to release the camera,
# so this waits up to VISION_STOP_TICKS x 0.25 s while the loop still has a child. A loop
# that stays alive for 1 s with no child left has nothing to wait for (1.2.1 could hang
# like this after an upgrade, at 100 % CPU) and is stopped with SIGKILL: no camera holder
# is involved then. rebot-vision itself is never sent SIGKILL (a killed camera holder
# leaves VPSS groups allocated). A pidfile naming another process is left alone.
stop_vision() {
    [ -n "$VISION_PIDFILE" ] && [ -f "$VISION_PIDFILE" ] || return 0
    VPID=$(cat "$VISION_PIDFILE" 2>/dev/null)
    case "$VPID" in ''|*[!0-9]*) rm -f "$VISION_PIDFILE"; return 0 ;; esac
    if [ ! -d "/proc/$VPID" ]; then rm -f "$VISION_PIDFILE"; return 0; fi
    if ! tr '\000' ' ' < "/proc/$VPID/cmdline" 2>/dev/null | grep -q "$VISION_RUNNER"; then
        echo "PID $VPID is not $VISION_RUNNER; leaving it"
        return 0
    fi
    kill -TERM "$VPID" 2>/dev/null || true
    w=0
    childless=0
    while [ "$w" -lt "${VISION_STOP_TICKS:-40}" ] && proc_alive "$VPID"; do
        if has_child "$VPID"; then childless=0; else childless=$((childless + 1)); fi
        if [ "$childless" -ge 4 ]; then
            echo "rebot-vision loop (PID $VPID) has no child left but did not exit; sending SIGKILL"
            logger -t "$NAME" "vision loop $VPID did not exit without a child; SIGKILL" 2>/dev/null || true
            kill -KILL "$VPID" 2>/dev/null || true
            k=0
            while [ "$k" -lt 8 ] && proc_alive "$VPID"; do sleep 0.25; k=$((k + 1)); done
            break
        fi
        sleep 0.25
        w=$((w + 1))
    done
    proc_alive "$VPID" && echo "rebot-vision still stopping (PID $VPID)" || rm -f "$VISION_PIDFILE"
    return 0
}

stop() {
    echo "Stopping $NAME..."
    stop_ap_guard
    stop_app
    stop_vision
    if [ ! -f "$PIDFILE" ]; then
        if ! command -v pidof >/dev/null 2>&1 || pidof armd >/dev/null 2>&1; then
            echo "Cannot confirm armd stopped: pidfile missing; leaving processes untouched"
            return 1
        fi
        echo "$NAME is not running"
        return 0
    fi

    PID=$(cat "$PIDFILE" 2>/dev/null)
    case "$PID" in
        ''|*[!0-9]*) echo "Invalid armd pidfile; refusing to signal any process"; return 1 ;;
    esac
    if [ ! -d "/proc/$PID" ]; then
        if ! command -v pidof >/dev/null 2>&1 || pidof armd >/dev/null 2>&1; then
            echo "Stale pidfile with untracked armd; refusing stop"
            return 1
        fi
        rm -f "$PIDFILE"
        stop_video
        return 0
    fi
    PROC_EXE=$(readlink "/proc/$PID/exe" 2>/dev/null | sed 's/ (deleted)$//')
    REAL_DAEMON=$(readlink -f "$DAEMON" 2>/dev/null || echo "$DAEMON")
    if [ "$PROC_EXE" != "$DAEMON" ] && [ "$PROC_EXE" != "$REAL_DAEMON" ]; then
        echo "PID $PID is not $DAEMON; refusing stop"
        return 1
    fi

    # armd may refuse shutdown while hardware disable is unconfirmed.
    kill -TERM "$PID" 2>/dev/null || return 1
    i=0
    while [ "$i" -lt 16 ]; do
        if [ ! -d "/proc/$PID" ]; then
            rm -f "$PIDFILE"
            stop_video
            echo "OK"
            return 0
        fi
        PROC_EXE=$(readlink "/proc/$PID/exe" 2>/dev/null | sed 's/ (deleted)$//')
        if [ -n "$PROC_EXE" ] && [ "$PROC_EXE" != "$DAEMON" ] && [ "$PROC_EXE" != "$REAL_DAEMON" ]; then
            echo "PID identity changed while stopping; retaining pidfile for inspection"
            return 1
        fi
        sleep 0.5
        i=$((i + 1))
    done
    echo "Stop not confirmed: armd remains active; support and unload the arm before retrying"
    return 1
}

status() {
    if VPID=$(vision_pid); then echo "rebot-vision is running (PID: $VPID)"; else echo "rebot-vision is not running"; fi
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE 2>/dev/null)
        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
            echo "$NAME is running (PID: $PID)"
            return 0
        fi
        rm -f $PIDFILE
    fi
    echo "$NAME is not running"
    return 1
}

case "$1" in
    start) start; exit $? ;;
    stop) stop; exit $? ;;
    restart) stop || exit $?; sleep 2; start; exit $? ;;
    status) status; exit $? ;;
    register) register_active_app; exit $? ;;
    stop-vision) stop_vision; exit $? ;;
    app-start) start_app "$2"; exit $? ;;
    app-stop) stop_app; exit $? ;;
    app-status) app_status; exit $? ;;
    app-logs) app_logs "$2"; exit $? ;;
    ap-guard) ap_guard "$2" "$3"; exit 0 ;;
    *) echo "Usage: $0 {start|stop|restart|status|register|stop-vision|ap-guard|app-start [name]|app-stop|app-status|app-logs [n]}"; exit 1 ;;
esac

exit 0
