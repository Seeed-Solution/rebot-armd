<!--
  reBot B601-DM grasp scene for rebot-sim (armd `- -follower sim`).

  Provenance and licence
  - Arm chain (joint origins, axes) and link inertials are taken from
    assets/reBot-DevArm_gripper.urdf of this repository, which is derived from
    https://github.com/Seeed-Projects/reBot-DevArm (CERN-OHL-W-2.0). The same numbers
    feed armd's gravity model (src/gravity.rs) and kinematics (src/kinematics.rs).
  - Gripper collision boxes follow the extents of the segmented finger, carriage and
    palm collision meshes of Rebot_Arm_description/DM/mjcf/rebotarm_b601_colored.xml
    (reBot-DevArm, CERN-OHL-W-2.0): jaw tips at the end_link origin, inner jaw faces
    at y = 0 when closed.
  - Modified 2026-11-11 for rebot-sim: meshes replaced by box primitives, finger
    inertials moved to the jaw blades, joint ranges set to the armd B601-DM profile
    limits plus 0.1 rad except the J2 / J3 upper stops at 0 (URDF upper limits: the
    folded resting pose q = 0 leans on them), velocity-servo actuators, table and cube.
  - This file is a modified Covered Source under CERN-OHL-W-2.0
    (https://ohwr.org/cern_ohl_w_v2.txt) and is not covered by the MIT License of
    this repository. No upstream meshes are included; set REBOT_DEVARM_DIR to a
    reBot-DevArm checkout to add the upstream link meshes as visuals in the viewer.

  Motor convention (armd DM): J1..J6 motor angle = URDF joint angle. J7 (gripper motor)
  drives both jaws through a rack: jaw opening per side = -q7 * 0.0425 / 5.7 m, so
  q7 = 0 is closed and q7 = -5.7 rad opens 85 mm. The J7 actuator acts on finger_left
  with gear -5.7 / 0.0425, so its length, velocity and force are motor angle (rad),
  motor velocity (rad/s) and motor torque (N·m); finger_right follows by equality.
-->
<mujoco model="rebot_b601dm_scene">
  <compiler angle="radian" eulerseq="XYZ" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81"/>
  <size memory="16M"/>

  <visual>
    <global azimuth="135" elevation="-25" offwidth="640" offheight="480"/>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.26 0.45 0.58" rgb2="0.12 0.30 0.43" width="256" height="256"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8" texuniform="true"/>
    <material name="table_mat" rgba="0.34 0.36 0.34 1"/>
    <material name="link_mat" rgba="0.78 0.80 0.78 1"/>
    <material name="gripper_mat" rgba="0.24 0.28 0.27 1"/>
    <material name="cube_mat" rgba="0.92 0.18 0.12 1"/>
  </asset>

  <default>
    <!-- damping / frictionloss: no Damiao data; damping 0.8 is the DM MJCF default of
         reBot-DevArm, frictionloss 0.05 N·m is an assumption. Armature is set per joint
         below (rotor inertia x gear ratio^2, see the motor table). -->
    <joint damping="0.8" armature="0.01" frictionloss="0.05"/>
    <!-- arm geoms collide with the world (table, cube) but not with each other -->
    <geom contype="2" conaffinity="1" condim="4" friction="1.0 0.02 0.002" solref="0.004 1" solimp="0.95 0.99 0.001" material="link_mat"/>
    <default class="world">
      <geom contype="1" conaffinity="1"/>
    </default>
    <default class="jaw">
      <geom material="gripper_mat" condim="6" friction="1.5 0.04 0.01" solref="0.002 1" solimp="0.98 0.995 0.0005"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="0.45 -0.65 1.3" dir="-0.45 0.65 -1"/>
    <geom name="floor" class="world" type="plane" pos="0 0 -0.75" size="1.5 1.5 0.02" material="floor_mat"/>
    <!-- table top surface at z = 0 = base_link plane (profile grasp.table_z_m 0.0) -->
    <geom name="table" class="world" type="box" pos="0.25 0 -0.015" size="0.45 0.50 0.015" material="table_mat"/>

    <body name="cube" pos="0.30 0 0.02">
      <freejoint name="cube"/>
      <geom name="cube" class="world" type="box" size="0.02 0.02 0.02" mass="0.03" material="cube_mat"
            condim="6" friction="1.2 0.04 0.01" solref="0.002 1" solimp="0.98 0.995 0.0005"/>
    </body>

    <body name="base_link" pos="0 0 0">
      <inertial pos="-7.849e-06 -1.1531e-06 0.029841" mass="0.8366" fullinertia="0.0013304 0.00213119 0.00275877 1e-08 0 0"/>
      <body name="link1" pos="-8.416e-05 0 0.08465">
        <joint name="joint1" axis="0 0 1" range="-3.24159 3.24159" armature="0.032"/>
        <inertial pos="0.000113614552951627 -0.000616319527051323 0.0236476372671394" mass="0.1613" fullinertia="0.00025207 0.00015464 0.00023416 0 -2.832e-05 0"/>
        <body name="link2" pos="0.020084 0.031625 0.05555" euler="-1.5708 0 0">
          <joint name="joint2" axis="0 0 -1" range="-2.1944 0" armature="0.032"/>
          <inertial pos="-0.13225622308888 -0.0030617036386309 -0.0308306967030205" mass="1.3266" fullinertia="0.00073374 0.01255987 0.01281387 -4.3e-07 8.51e-06 1.28e-06"/>
          <geom name="link2" type="box" pos="-0.132 0 -0.0316" size="0.1605 0.0285 0.0337"/>
          <body name="link3" pos="-0.264 0 0">
            <joint name="joint3" axis="0 0 1" range="-2.71799 0" armature="0.032"/>
            <inertial pos="0.121040035791843 -0.0536211076627949 -0.0310137854608077" mass="0.8353" fullinertia="0.00046807 0.00632695 0.00648221 -3.456e-05 -4.26e-05 6e-08"/>
            <geom name="link3" type="box" pos="0.1222 -0.03 -0.0311" size="0.1489 0.0525 0.0401"/>
            <body name="link4" pos="0.2426 -0.054 -0.001625">
              <joint name="joint4" axis="0 0 1" range="-3.24159 3.24159" armature="0.0018"/>
              <inertial pos="0.0608200956293136 -0.0511711906613122 -0.030299458623927" mass="0.52" fullinertia="0.00045986 0.00075258 0.00066742 0.00024219 -6.72e-06 -5.35e-06"/>
              <geom name="link4" type="box" pos="0.0449 -0.03 -0.03" size="0.0729 0.058 0.0334"/>
              <body name="link5" pos="0.078308 -0.0375 -0.03" euler="-1.5708 0 0">
                <joint name="joint5" axis="0 0 1" range="-2.1944 2.1944" armature="0.0018"/>
                <inertial pos="-0.00502802058982517 1.73866206692364e-06 0.0386233236326755" mass="0.383" fullinertia="0.00019772 0.00021737 0.00017191 -6.2e-07 -2.426e-05 2e-08"/>
                <geom name="link5" type="box" pos="-0.0028 0 0.0355" size="0.035 0.0385 0.0425"/>
                <body name="link6" pos="0.028008 0 0.04" euler="0 1.5708 0">
                  <joint name="joint6" axis="0 0 1" range="-6.38318 6.38318" armature="0.0018"/>
                  <inertial pos="3.76418727127126e-06 -0.000100908819946677 0.0253308606425965" mass="0.3663" fullinertia="0.00015554 0.00015554 0.00013966 0 0 0"/>
                  <geom name="link6" type="box" pos="0 0 0.0242" size="0.0385 0.0318 0.029"/>
                  <!-- end_link origin = jaw tips (TCP); end_link x = tool axis, jaws close along y -->
                  <body name="end_link" pos="0 0 0.15539" euler="0 -1.5708 3.1415">
                    <inertial pos="-0.0737654295815033 -9.5080995865868e-06 7.04327840286845e-06" mass="0.55" fullinertia="0.00037354 0.0001583 0.00045353 -1.1e-07 5e-07 3.48e-06"/>
                    <site name="tcp" pos="0 0 0" size="0.006" rgba="1 0.34 0.16 1"/>
                    <geom name="palm" class="jaw" type="box" pos="-0.08995 0 0" size="0.01675 0.092 0.0342"/>
                    <geom name="motor_housing" type="box" pos="-0.13 0 0" size="0.0233 0.03 0.03" material="gripper_mat"/>
                    <body name="finger_left" pos="0 0 0">
                      <joint name="finger_left" type="slide" axis="0 1 0" range="-0.001 0.044" damping="2" armature="16.2" frictionloss="0.2"/>
                      <inertial pos="-0.035 0.0157 0" mass="0.03" diaginertia="4e-06 1.1e-05 1.1e-05"/>
                      <geom name="left_front" class="jaw" type="box" pos="-0.015 0.00635 0" size="0.015 0.00635 0.0105"/>
                      <geom name="left_mid" class="jaw" type="box" pos="-0.0395 0.0071 0" size="0.0095 0.0071 0.0165"/>
                      <geom name="left_rear" class="jaw" type="box" pos="-0.0569 0.01565 0" size="0.0079 0.01565 0.0196"/>
                      <geom name="left_carriage" class="jaw" type="box" pos="-0.0737 0.0182 0" size="0.0089 0.0131 0.0192"/>
                    </body>
                    <body name="finger_right" pos="0 0 0">
                      <joint name="finger_right" type="slide" axis="0 -1 0" range="-0.001 0.044" damping="2" armature="16.2" frictionloss="0.2"/>
                      <inertial pos="-0.035 -0.0157 0" mass="0.03" diaginertia="4e-06 1.1e-05 1.1e-05"/>
                      <geom name="right_front" class="jaw" type="box" pos="-0.015 -0.00635 0" size="0.015 0.00635 0.0105"/>
                      <geom name="right_mid" class="jaw" type="box" pos="-0.0395 -0.0071 0" size="0.0095 0.0071 0.0165"/>
                      <geom name="right_rear" class="jaw" type="box" pos="-0.0569 -0.01565 0" size="0.0079 0.01565 0.0196"/>
                      <geom name="right_carriage" class="jaw" type="box" pos="-0.0737 -0.0182 0" size="0.0089 0.0131 0.0192"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint name="jaw_coupling" joint1="finger_right" joint2="finger_left" polycoef="0 1 0 0 0" solref="0.002 1" solimp="0.99 0.995 0.001"/>
  </equality>

  <!-- Velocity servos: rebot-sim sets kv per step (POS_VEL velocity loop, or MIT kd) and
       adds the position / feed-forward terms as qfrc_applied. forcerange = Damiao peak
       torque (N·m, output side): DM-J4340P-2EC 27 on J1..J3, DM-J4310-2EC V1.1 7 on J4..J7
       (Seeed wiki damiao_series / Damiao manuals; see docs/simulation.md).

       Armature = rotor inertia x gear ratio^2 (Seeed wiki damiao_series table):
       DM4340P 2.0e-5 x 40^2 = 0.032 kg·m², DM4310 1.8e-5 x 10^2 = 0.0018 kg·m². The J7
       rotor reflects onto the jaw slides as 0.0018 x (5.7 / 0.0425)^2 = 32.4 kg, split
       16.2 kg per jaw joint (the jaws are coupled 1:1). Jaw damping 2 N·s/m and friction
       0.2 N are assumptions. -->
  <actuator>
    <velocity name="m1" joint="joint1" kv="5" forcerange="-27 27"/>
    <velocity name="m2" joint="joint2" kv="5" forcerange="-27 27"/>
    <velocity name="m3" joint="joint3" kv="5" forcerange="-27 27"/>
    <velocity name="m4" joint="joint4" kv="1" forcerange="-7 7"/>
    <velocity name="m5" joint="joint5" kv="1" forcerange="-7 7"/>
    <velocity name="m6" joint="joint6" kv="1" forcerange="-7 7"/>
    <velocity name="m7" joint="finger_left" gear="-134.1176" kv="0.05" forcerange="-7 7"/>
  </actuator>

  <sensor>
    <framepos name="tcp_pos" objtype="site" objname="tcp"/>
  </sensor>
</mujoco>
