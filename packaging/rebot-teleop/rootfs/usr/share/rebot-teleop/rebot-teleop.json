{
  "id": "rebot-teleop",
  "name": "reBot Teleoperation & Vision",
  "name_zh": "reBot 具身视觉遥控与机械臂驱动",
  "scene": "Robotics & Embodied AI",
  "scene_zh": "机器人与具身智能",
  "description": "Transform reCamera into an Embodied AI controller: auto Wi-Fi AP hotspot, edge TPU YOLOv11 target detection, and direct serial control for SO-ARM 101 / reBot robotic arms with touch teleoperation and LeRobot dataset recording.",
  "description_zh": "将 reCamera 变身为具身智能主控终端：开机自启 Wi-Fi 热点免路由直连、端侧 TPU 运行 YOLOv11 目标检测，板载串口直连驱动 SO-ARM 101 / reBot 机械臂，支持手机触屏双摇杆遥控与 LeRobot 示教轨迹录制。",
  "type": "native",
  "init_script": "/etc/init.d/K92rebot-teleop",
  "rtsp_url": "rtsp://{host}:8554/live0",
  "web_port": 8765,
  "models": [],
  "config_schema": {
    "groups": [
      {
        "key": "arm",
        "title": "Robotic Arm Hardware",
        "title_zh": "机械臂硬件配置",
        "items": [
          {
            "key": "follower_model",
            "type": "select",
            "title": "Arm Model",
            "title_zh": "机械臂型号",
            "options": ["so-arm101", "rebot-rs", "rebot-dm", "mock"],
            "default": "so-arm101"
          },
          {
            "key": "serial_port",
            "type": "serial_port",
            "title": "Serial Port",
            "title_zh": "从手串口端口",
            "default": "/dev/ttyS1"
          },
          {
            "key": "baud_rate",
            "type": "number",
            "title": "Baud Rate",
            "title_zh": "波特率",
            "default": 1000000
          }
        ]
      },
      {
        "key": "network",
        "title": "Wi-Fi Hotspot & Client",
        "title_zh": "Wi-Fi 热点与联网配置",
        "items": [
          {
            "key": "ap_ssid",
            "type": "text",
            "title": "AP Hotspot SSID",
            "title_zh": "热点名称 (SSID)",
            "default": "reCamera-Arm-Teleop"
          },
          {
            "key": "ap_password",
            "type": "password",
            "title": "AP Password",
            "title_zh": "热点密码 (至少8位)",
            "default": "12345678"
          },
          {
            "key": "ap_ip",
            "type": "text",
            "title": "AP Gateway IP",
            "title_zh": "热点网关 IP",
            "default": "192.168.16.1"
          },
          {
            "key": "sta_ssid",
            "type": "text",
            "title": "External Wi-Fi SSID",
            "title_zh": "外部 Wi-Fi 名称 (可选)",
            "default": ""
          },
          {
            "key": "sta_password",
            "type": "password",
            "title": "External Wi-Fi Password",
            "title_zh": "外部 Wi-Fi 密码",
            "default": ""
          }
        ]
      }
    ]
  }
}
