{
  "id": "26_stop_ordinary_reqid_and_torque_disable",
  "family": "stop",
  "description": "urgent Stop request_id=100 does not block ordinary request_id=11; duplicate ordinary fails; torque disable succeeds",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":10,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/motion/stop","request_id":100,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":false},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":11,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":false},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":11,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":10,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"control_mode":"position","epoch_id":1,"is_torqued":true,"request_id":10,"safety_state":"Armed","status":"accepted","type":"command_ack"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{},"epoch_id":1,"generation":1,"path":"/api/v1/motion/stop","request_id":100,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"control_mode":"position","epoch_id":1,"is_torqued":true,"request_id":100,"safety_state":"Armed","status":"accepted","stop_generation":1,"type":"command_ack"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":false},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":11,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"control_mode":"position","epoch_id":1,"is_torqued":false,"request_id":11,"safety_state":"Idle","status":"accepted","type":"command_ack"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":false},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":11,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","error":"INVALID_COMMAND","message":"request_id must be present and strictly increase","request_id":11,"status":400,"type":"command_reject"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
