{
  "id": "29_heartbeat_renew_sync_and_expiry",
  "family": "heartbeat",
  "description": "heartbeat valid & omitted gen, stale epoch -> epoch_sync, short lease_timeout_ms expiry -> lease_lost expired",
  "setup": {"profile":"rebot_dm_short_lease","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"hb_client","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","type":"heartbeat"}},
    {"op":"expect_no_control","client":"c0","wait_ms":60},
    {"op":"send","client":"c0","frame":{"epoch_id":"{{epoch}}","type":"heartbeat"}},
    {"op":"expect_no_control","client":"c0","wait_ms":60},
    {"op":"send","client":"c0","frame":{"epoch_id":999999,"generation":"{{gen:c0}}","type":"heartbeat"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"sleep_ms","ms":550},
    {"op":"send","client":"c0","frame":{"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","type":"heartbeat"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"hb_client","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"hb_client","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"epoch_id":1,"generation":1,"type":"heartbeat"}},
    {"ev":"no_reply","client":"c0"},
    {"ev":"client_frame","client":"c0","frame":{"epoch_id":1,"type":"heartbeat"}},
    {"ev":"no_reply","client":"c0"},
    {"ev":"client_frame","client":"c0","frame":{"epoch_id":999999,"generation":1,"type":"heartbeat"}},
    {"ev":"server_frame","client":"c0","frame":{"epoch_id":1,"safety_state":"Idle","type":"epoch_sync"}},
    {"ev":"client_frame","client":"c0","frame":{"epoch_id":1,"generation":1,"type":"heartbeat"}},
    {"ev":"server_frame","client":"c0","frame":{"generation":1,"reason":"expired","type":"lease_lost"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"LEASE_LOST","epoch_id":1,"error":"LEASE_LOST","message":"This connection does not own an active lease","request_id":1,"status":409,"type":"command_reject"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
