{
  "id": "33_unknown_frames_and_paths",
  "family": "dispatch",
  "description": "malformed text ignored; unknown type without gen -> lease_lost, with valid gen+epoch -> ignored; unknown command vs action errors; req_id & duration_secs validation",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send_raw","client":"c0","text":"not-valid-json{{{"},
    {"op":"expect_no_control","client":"c0","wait_ms":40},
    {"op":"send","client":"c0","frame":{"foo":1,"type":"unknown_msg_kind"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"epoch_id":"{{epoch}}","foo":1,"generation":"{{gen:c0}}","type":"unknown_msg_kind"}},
    {"op":"expect_no_control","client":"c0","wait_ms":40},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/does_not_exist","request_id":1,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/action/does_not_exist","request_id":2,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"duration_secs":"nope","enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":3,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_raw","client":"c0","text":"not-valid-json{{{"},
    {"ev":"no_reply","client":"c0"},
    {"ev":"client_frame","client":"c0","frame":{"foo":1,"type":"unknown_msg_kind"}},
    {"ev":"server_frame","client":"c0","frame":{"generation":1,"reason":"expired","type":"lease_lost"}},
    {"ev":"client_frame","client":"c0","frame":{"epoch_id":1,"foo":1,"generation":1,"type":"unknown_msg_kind"}},
    {"ev":"no_reply","client":"c0"},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":1,"generation":1,"path":"/api/v1/torque","type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","error":"INVALID_COMMAND","message":"request_id must be present and strictly increase","request_id":null,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{},"epoch_id":1,"generation":1,"path":"/api/v1/does_not_exist","request_id":1,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","epoch_id":1,"error":"INVALID_COMMAND","message":"Unknown actuator command","request_id":1,"safety_state":null,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{},"epoch_id":1,"generation":1,"path":"/api/v1/action/does_not_exist","request_id":2,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","epoch_id":1,"error":"INVALID_COMMAND","message":"Unknown action","request_id":2,"safety_state":null,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"duration_secs":"nope","enable":true},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":3,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","epoch_id":1,"error":"INVALID_COMMAND","message":"duration_secs must be numeric","request_id":3,"safety_state":null,"status":400,"type":"command_reject"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
