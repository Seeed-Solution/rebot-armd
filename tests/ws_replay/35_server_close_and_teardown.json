{
  "id": "35_server_close_and_teardown",
  "family": "close",
  "description": "explicit WS Close frame drives clean server EOF teardown (distinct from Frame/TransportError) and releases lease",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"connect","client":"c1"},
    {"op":"send","client":"c0","frame":{"client_id":"closing_holder","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send_close_frame","client":"c0","code":1000,"reason":"client_done"},
    {"op":"expect_close","client":"c0"},
    {"op":"sleep_ms","ms":40},
    {"op":"send","client":"c1","frame":{"client_id":"after_close","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c1","count":1},
    {"op":"close_client","client":"c1"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"upgrade_status","client":"c1","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"closing_holder","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"closing_holder","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_close_frame","client":"c0","code":1000,"reason":"client_done"},
    {"ev":"server_close","client":"c0","close":{"outcome":"transport_error"}},
    {"ev":"client_frame","client":"c1","frame":{"client_id":"after_close","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c1","frame":{"client_id":"after_close","generation":2,"seq":1,"type":"lease_granted"}},
    {"ev":"client_closed","client":"c1"}
  ]
}
