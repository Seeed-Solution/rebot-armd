{
  "id": "23_estop_aliases_and_clear_fault",
  "family": "estop",
  "description": "estop & e_stop aliases, stale epoch EPOCH_MISMATCH, torque refused in EStop, clear_fault valid & invalid mit_recovery",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"type":"estop"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":0,"generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":2,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"mit_recovery":"bad"},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/safety/clear_fault","request_id":3,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/safety/clear_fault","request_id":4,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"request_id":99,"type":"e_stop"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/safety/clear_fault","request_id":5,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"type":"estop"}},
    {"ev":"server_frame","client":"c0","frame":{"epoch_id":2,"safety_state":"EStop","type":"epoch_sync"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":0,"generation":1,"path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"EPOCH_MISMATCH","epoch_id":2,"error":"EPOCH_MISMATCH","message":"Command epoch is no longer current","request_id":1,"status":409,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":2,"generation":1,"path":"/api/v1/torque","request_id":2,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"ESTOP_ACTIVE","epoch_id":2,"error":"ESTOP_ACTIVE","message":"E-Stop is latched, motion rejected","request_id":2,"safety_state":"EStop","status":409,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"mit_recovery":"bad"},"epoch_id":2,"generation":1,"path":"/api/v1/safety/clear_fault","request_id":3,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","epoch_id":2,"error":"INVALID_COMMAND","message":"mit_recovery must be \"torque_off_all\"","request_id":3,"safety_state":null,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{},"epoch_id":2,"generation":1,"path":"/api/v1/safety/clear_fault","request_id":4,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"control_mode":"position","epoch_id":3,"is_torqued":false,"request_id":4,"safety_state":"Idle","status":"accepted","type":"command_ack"}},
    {"ev":"client_frame","client":"c0","frame":{"request_id":99,"type":"e_stop"}},
    {"ev":"server_frame","client":"c0","frame":{"epoch_id":4,"safety_state":"EStop","type":"epoch_sync"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{},"epoch_id":4,"generation":1,"path":"/api/v1/safety/clear_fault","request_id":5,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"control_mode":"position","epoch_id":5,"is_torqued":false,"request_id":5,"safety_state":"Idle","status":"accepted","type":"command_ack"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
