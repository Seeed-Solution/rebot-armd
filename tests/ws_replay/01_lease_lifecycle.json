{
  "id": "01_lease_lifecycle",
  "family": "lease",
  "description": "acquire with seq, same-connection renew, release, double release, post-release LEASE_LOST",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl_a","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl_a","seq":2,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"generation":"{{gen:c0}}","type":"release_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"generation":"{{gen:c0}}","type":"release_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl_a","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl_a","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl_a","seq":2,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl_a","generation":1,"seq":2,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"generation":1,"type":"release_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"success":true,"type":"lease_released"}},
    {"ev":"client_frame","client":"c0","frame":{"generation":1,"type":"release_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"success":false,"type":"lease_released"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"LEASE_LOST","epoch_id":1,"error":"LEASE_LOST","message":"This connection does not own an active lease","request_id":1,"status":409,"type":"command_reject"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
