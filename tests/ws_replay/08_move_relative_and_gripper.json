{
  "id": "08_move_relative_and_gripper",
  "family": "move_relative",
  "description": "move_relative base frame + terminal, gripper open/close + baseline reject, gripper_zero_check",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":false,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"enable":true},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"duration_secs":0.15,"target_positions":[0.0,-1.167,-1.565,1.435,0.0,0.0,0.0]},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/motion/jog","request_id":2,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1,"capture_action":"go"},
    {"op":"expect_terminal","client":"c0","action_alias":"go"},
    {"op":"send","client":"c0","frame":{"body":{"d":[0.0,0.0,0.02],"frame":"base","speed_scale":0.8},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/action/move_relative","request_id":3,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1,"capture_action":"mr"},
    {"op":"expect_terminal","client":"c0","action_alias":"mr"},
    {"op":"send","client":"c0","frame":{"body":{"command":"open","speed":1.5},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/action/gripper","request_id":4,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1,"capture_action":"g1"},
    {"op":"expect_terminal","client":"c0","action_alias":"g1"},
    {"op":"send","client":"c0","frame":{"body":{"command":"move","fraction":0.5,"speed_scale":0.8},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/action/gripper","request_id":5,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1,"capture_action":"g2"},
    {"op":"expect_terminal","client":"c0","action_alias":"g2"},
    {"op":"send","client":"c0","frame":{"body":{"baseline":"x","command":"open"},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/action/gripper","request_id":6,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/action/gripper_zero_check","request_id":7,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"enable":true},"epoch_id":1,"generation":1,"path":"/api/v1/torque","request_id":1,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"control_mode":"position","epoch_id":1,"is_torqued":true,"request_id":1,"safety_state":"Armed","status":"accepted","type":"command_ack"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"duration_secs":0.15,"target_positions":[0.0,-1.167,-1.565,1.435,0.0,0.0,0.0]},"epoch_id":1,"generation":1,"path":"/api/v1/motion/jog","request_id":2,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"action_id":1,"control_mode":"position","epoch_id":1,"expected_duration_s":6.520833744495015,"is_torqued":true,"request_id":2,"safety_state":"Moving","status":"accepted","type":"command_ack"}},
    {"ev":"action_terminal","client":"c0","action_id":1,"kind":"joint_move","state":"done","code":null,"safety_state":"Armed","epoch_id":1,"is_torqued":true,"control_mode":"position"},
    {"ev":"client_frame","client":"c0","frame":{"body":{"d":[0.0,0.0,0.02],"frame":"base","speed_scale":0.8},"epoch_id":1,"generation":1,"path":"/api/v1/action/move_relative","request_id":3,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"action_id":2,"control_mode":"position","epoch_id":1,"expected_duration_s":1.0959076343882783,"is_torqued":true,"request_id":3,"safety_state":"Moving","status":"accepted","type":"command_ack"}},
    {"ev":"action_terminal","client":"c0","action_id":2,"kind":"move_relative","state":"done","code":null,"safety_state":"Armed","epoch_id":1,"is_torqued":true,"control_mode":"position"},
    {"ev":"client_frame","client":"c0","frame":{"body":{"command":"open","speed":1.5},"epoch_id":1,"generation":1,"path":"/api/v1/action/gripper","request_id":4,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"action_id":3,"control_mode":"position","epoch_id":1,"expected_duration_s":4.599999872843424,"is_torqued":true,"request_id":4,"safety_state":"Moving","status":"accepted","type":"command_ack"}},
    {"ev":"action_terminal","client":"c0","action_id":3,"kind":"gripper","state":"done","code":null,"safety_state":"Armed","epoch_id":1,"is_torqued":true,"control_mode":"position"},
    {"ev":"client_frame","client":"c0","frame":{"body":{"command":"move","fraction":0.5,"speed_scale":0.8},"epoch_id":1,"generation":1,"path":"/api/v1/action/gripper","request_id":5,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"action_id":4,"control_mode":"position","epoch_id":1,"expected_duration_s":2.581247854232788,"is_torqued":true,"request_id":5,"safety_state":"Moving","status":"accepted","type":"command_ack"}},
    {"ev":"action_terminal","client":"c0","action_id":4,"kind":"gripper","state":"done","code":null,"safety_state":"Moving","epoch_id":1,"is_torqued":true,"control_mode":"position"},
    {"ev":"client_frame","client":"c0","frame":{"body":{"baseline":"x","command":"open"},"epoch_id":1,"generation":1,"path":"/api/v1/action/gripper","request_id":6,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","epoch_id":1,"error":"INVALID_COMMAND","message":"baseline is not a gripper action field; calibrate with /api/v1/action/gripper_calibrate","request_id":6,"safety_state":null,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{},"epoch_id":1,"generation":1,"path":"/api/v1/action/gripper_zero_check","request_id":7,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"action_id":5,"control_mode":"position","epoch_id":1,"expected_duration_s":10.633350976308188,"is_torqued":true,"request_id":7,"safety_state":"Moving","status":"accepted","type":"command_ack"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
