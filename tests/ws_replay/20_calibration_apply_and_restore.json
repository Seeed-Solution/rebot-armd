{
  "id": "20_calibration_apply_and_restore",
  "family": "calibration",
  "description": "calibration/apply dry_run & invalid body, calibration/restore non-object & missing backup",
  "setup": {"profile":"rebot_dm","seed_poses":false,"seed_episode":false,"seed_policy":false,"seed_calibration":true,"mock_detector":false},
  "steps": [
    {"op":"connect","client":"c0"},
    {"op":"send","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"camera_mount":{"offset_m":[0.0,0.0,0.05],"q_end_cam":[0.0,0.0,0.0,1.0]},"dry_run":true,"intrinsics":{"cx":320.0,"cy":240.0,"fx":600.0,"fy":600.0,"height":480,"width":640},"table_z_m":0.0},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/calibration/apply","request_id":1,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"bogus":1},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/calibration/apply","request_id":2,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":123,"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/calibration/restore","request_id":3,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"send","client":"c0","frame":{"body":{"backup":"missing.json"},"epoch_id":"{{epoch}}","generation":"{{gen:c0}}","path":"/api/v1/calibration/restore","request_id":4,"type":"command"}},
    {"op":"expect_control","client":"c0","count":1},
    {"op":"close_client","client":"c0"}
  ],
  "events": [
    {"ev":"upgrade_status","client":"c0","status":101},
    {"ev":"client_frame","client":"c0","frame":{"client_id":"ctrl","seq":1,"type":"acquire_lease"}},
    {"ev":"server_frame","client":"c0","frame":{"client_id":"ctrl","generation":1,"seq":1,"type":"lease_granted"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"camera_mount":{"offset_m":[0.0,0.0,0.05],"q_end_cam":[0.0,0.0,0.0,1.0]},"dry_run":true,"intrinsics":{"cx":320.0,"cy":240.0,"fx":600.0,"fy":600.0,"height":480,"width":640},"table_z_m":0.0},"epoch_id":1,"generation":1,"path":"/api/v1/calibration/apply","request_id":1,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","error":"INVALID_COMMAND","message":"intrinsics.k1 must be a finite number","request_id":1,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"bogus":1},"epoch_id":1,"generation":1,"path":"/api/v1/calibration/apply","request_id":2,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","error":"INVALID_COMMAND","message":"unknown field: bogus","request_id":2,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":123,"epoch_id":1,"generation":1,"path":"/api/v1/calibration/restore","request_id":3,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","error":"INVALID_COMMAND","message":"Command body must be an object","request_id":3,"status":400,"type":"command_reject"}},
    {"ev":"client_frame","client":"c0","frame":{"body":{"backup":"missing.json"},"epoch_id":1,"generation":1,"path":"/api/v1/calibration/restore","request_id":4,"type":"command"}},
    {"ev":"server_frame","client":"c0","frame":{"code":"INVALID_COMMAND","epoch_id":1,"error":"INVALID_COMMAND","is_torqued":false,"message":"backup must be the name of a backup (GET /api/v1/calibration)","request_id":4,"safety_state":"Idle","status":400,"type":"command_reject"}},
    {"ev":"client_closed","client":"c0"}
  ]
}
